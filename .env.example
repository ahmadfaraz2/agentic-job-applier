# ==============================================================================
# Antigravity Autonomous Agent Configuration
# ==============================================================================
# NO GEMINI API KEY REQUIRED:
# The agent automatically leverages your active authenticated Google Antigravity
# session via the `agy` CLI with Gemini 3.8 Flash (High).
#
# (Optional) If you prefer using a local model (Ollama / LM Studio):
# LOCAL_OPENAI_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=llama3

# ==============================================================================
# SMTP Email Service Configuration
# ==============================================================================
# Supported providers: Gmail, Outlook, AWS SES, SendGrid, Mailgun, custom
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Antigravity Job Automation Bot

# Recipient email where qualified job digests & alert summaries will be delivered:
ALERT_RECIPIENT_EMAIL=your_inbox@example.com

# ==============================================================================
# Job Search & Qualification Preferences
# ==============================================================================
JOB_SEARCH_QUERY=Python AI Agent LLM Fullstack Developer
MIN_HOURLY_RATE=50
MIN_PROJECT_BUDGET=1000
REMOTE_ONLY=true
MIN_MATCH_SCORE=75

# Scheduler interval in seconds (e.g. 3600 = 1 hour, 1800 = 30 mins, 300 = 5 mins)
SCAN_INTERVAL_SECONDS=3600
