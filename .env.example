# ==============================================================================
# Antigravity Autonomous Agent Configuration
# ==============================================================================
# NO GEMINI API KEY REQUIRED:
# The agent automatically leverages your active authenticated Google Antigravity
# session via the `agy` CLI with Gemini 3.8 Flash (High).
#
# (Optional) If you prefer using a local model (Ollama / LM Studio):
# LOCAL_OPENAI_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=llama3

# ==============================================================================
# SMTP & IMAP Email Service Configuration
# ==============================================================================
# Supported provider: Gmail with 2-Step Verification & App Password
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Ahmad Faraz
SENDER_PHONE=+92 300 0000000

# IMAP Inbound Reply Listener
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Recipient email where preview digests and alerts are delivered
ALERT_RECIPIENT_EMAIL=your_email@gmail.com

# ==============================================================================
# Real-Time Discord Notifications & Interactive Bot
# ==============================================================================
# 1. Real-time Channel Notifications (Optional Webhook):
# Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 2. Interactive Discord Bot (Paste LinkedIn posts directly into DMs!):
# Create at https://discord.com/developers/applications
# Enable: Privileged Gateway Intents -> MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# (Recommended) Restrict the bot exclusively to your own Discord account ID:
# To find your ID: Discord Settings > Advanced > Developer Mode (ON) > Right click your avatar > Copy User ID
DISCORD_OWNER_ID=your_discord_user_id

# ==============================================================================
# Job Search Preferences
# ==============================================================================
JOB_SEARCH_QUERY=Python Developer
MIN_HOURLY_RATE=0.0
REMOTE_ONLY=false
MIN_MATCH_SCORE=75
SCAN_INTERVAL_SECONDS=3600
